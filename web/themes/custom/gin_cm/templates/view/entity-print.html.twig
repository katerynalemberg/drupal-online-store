<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <title>{{ title }}</title>
  {{ entity_print_css }}
</head>
<body>
<div class="page">

  {% if certificate_title %}
    <h1>{{ certificate_title }}</h1>
  {% endif %}

  {% if certificate_description %}
    <p>{{ certificate_description }}</p>
  {% endif %}

  {% if image %}
    <div class="certificate-image">
      {{ image }}
    </div>
  {% endif %}

  {% if user_name %}
    <p>{{ 'The certification if proudly presented to:'|t }} {{ user_name }}</p>
  {% endif %}

  {% if date %}
    <p>{{ 'Created on:'|t }} {{ date }}</p>
  {% endif %}
</div>
</body>
</html>
